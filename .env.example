# ──────────────────────────────────────────────────────────────────────────
# RALLY — Environment Configuration
#
# Copy this file to .env and fill in your values.
# NEVER commit the .env file with real secrets.
# ──────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────────
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_NAME=RALLY API
APP_VERSION=0.1.0

# ── Database ─────────────────────────────────────────────────────────────
# Local development default (matches docker-compose.yml)
DATABASE_URL=postgresql+asyncpg://rally:rally@localhost:5432/rally

# ── Logging ──────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── CORS ─────────────────────────────────────────────────────────────────
# Comma-separated list. Development default: Vite dev server.
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ── AWS (Phase 7 — AWS Builder Integration) ─────────────────────────────
# Region for Amazon Bedrock runtime (e.g. us-east-1, us-west-2)
AWS_REGION=us-east-1
# Bedrock foundation model ID for reasoning and hypothesis synthesis
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
# Set to true only if valid AWS credentials exist to run live Bedrock tests
RUN_AWS_INTEGRATION_TESTS=false
# AWS Credentials should ideally come from AWS IAM roles or ~/.aws/credentials.
# If using environment variables, configure these locally (NEVER commit secrets):
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# ── Frontend (apps/web) ───────────────────────────────────────────────────
# These are used by Vite at build time — prefix with VITE_
VITE_API_BASE_URL=http://localhost:8000

# ── Alexa+ MCP (Phase 8 — Alexa+ Integration) ───────────────────────────
# Public HTTPS URL of the RALLY Streamable HTTP MCP server (e.g., cloudflared tunnel)
RALLY_MCP_PUBLIC_URL=
# Enable OAuth 2.1 authentication on the external MCP gateway
RALLY_MCP_AUTH_ENABLED=false
# Canonical OAuth Protected Resource URI for RFC 8707 / RFC 9207 discovery
RALLY_MCP_OAUTH_RESOURCE=
# Required OAuth scopes for Alexa+ client
RALLY_MCP_REQUIRED_SCOPES=["rally:incident:read","rally:incident:write"]
