# ──────────────────────────────────────────────────────────────────────────
# RALLY — Environment Configuration
#
# Copy this file to .env and fill in your values.
# NEVER commit the .env file with real secrets.
# ──────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────────
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_NAME=RALLY API
APP_VERSION=0.1.0

# ── Database ─────────────────────────────────────────────────────────────
# Local development default (matches docker-compose.yml)
DATABASE_URL=postgresql+asyncpg://rally:rally@localhost:5432/rally

# ── Logging ──────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── CORS ─────────────────────────────────────────────────────────────────
# Comma-separated list. Development default: Vite dev server.
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ── AWS (Phase 7 — do not configure in Phase 1) ──────────────────────────
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# BEDROCK_MODEL_ID=

# ── Frontend (apps/web) ───────────────────────────────────────────────────
# These are used by Vite at build time — prefix with VITE_
VITE_API_BASE_URL=http://localhost:8000
