# ──────────────────────────────────────────────────────────────────────────
# RALLY — Environment Configuration (Phase 10A Production Foundation)
#
# Copy this file to .env and adjust values for local development or staging.
# NEVER commit the .env file with real secrets.
# ──────────────────────────────────────────────────────────────────────────

# ── 1. Application ────────────────────────────────────────────────────────
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_NAME=RALLY API
APP_VERSION=0.1.0

# ── 2. Database (PostgreSQL / AWS RDS) ────────────────────────────────────
# Local development default (matches docker-compose.yml)
DATABASE_URL=postgresql+asyncpg://rally:rally@localhost:5432/rally
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30.0
DB_POOL_RECYCLE=1800
DB_CONNECT_TIMEOUT=10.0

# ── 3. AWS Credentials & Region ───────────────────────────────────────────
# Preferred: IAM role or ~/.aws/credentials (AWS_PROFILE).
# Never commit hardcoded keys.
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1
# AWS_PROFILE=default

# ── 4. Secrets Management ─────────────────────────────────────────────────
# Backend options: 'env' (default local/testing) or 'aws_secrets_manager' (production)
SECRETS_BACKEND=env
AWS_SECRETS_MANAGER_ENABLED=false

# ── 5. Bedrock (Amazon Bedrock Converse API) ──────────────────────────────
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_MAX_TOKENS=4096
BEDROCK_TIMEOUT_SECONDS=30.0
BEDROCK_MAX_RETRIES=2
RUN_AWS_INTEGRATION_TESTS=false

# ── 6. MCP (Model Context Protocol Runtime) ───────────────────────────────
MCP_HOST=127.0.0.1
MCP_PORT=8001
MCP_PUBLIC_URL=
MCP_AUTH_ENABLED=false
MCP_OAUTH_RESOURCE=
MCP_REQUIRED_SCOPES=["rally:incident:read","rally:incident:write"]
MCP_REQUEST_TIMEOUT=30.0
MCP_MAX_RETRIES=2

# Legacy aliases supported for backward compatibility:
# RALLY_MCP_PUBLIC_URL=
# RALLY_MCP_AUTH_ENABLED=false
# RALLY_MCP_OAUTH_RESOURCE=
# RALLY_MCP_REQUIRED_SCOPES=["rally:incident:read","rally:incident:write"]

# ── 7. Security ───────────────────────────────────────────────────────────
AUTH_ENABLED=false
APPROVAL_AUTH_TOKEN=
# Comma-separated or JSON list of allowed origins
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ── 8. Observability (OpenTelemetry & CloudWatch) ─────────────────────────
LOG_LEVEL=INFO
OTEL_SERVICE_NAME=rally-api
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
CLOUDWATCH_LOGGING_ENABLED=false

# ── 9. Frontend (apps/web) ────────────────────────────────────────────────
# Used by Vite at build time — prefix with VITE_
VITE_API_BASE_URL=http://localhost:8000
