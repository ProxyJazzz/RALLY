# RALLY — API Dockerfile (Production)
# Multi-stage build with non-root user, healthcheck, and deterministic dependencies.

FROM python:3.12-slim AS builder

WORKDIR /build

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml ./

RUN pip install --no-cache-dir --upgrade \
    pip \
    setuptools \
    wheel

RUN pip install --no-cache-dir --prefix=/install .

# ── Final Runtime Stage ─────────────────────────────────────────────────────
FROM python:3.12-slim AS runtime

WORKDIR /app

# Install minimal runtime system libraries
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    libpq5 \
    && rm -rf /var/lib/apt/lists/*

# Create dedicated non-root user
RUN groupadd -r rally && useradd -r -g rally -d /app -s /sbin/nologin rally

# Copy installed python dependencies from builder
COPY --from=builder /install /usr/local

# Copy application source code
COPY --chown=rally:rally . .

# Set environment
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    APP_ENV=production \
    APP_HOST=0.0.0.0 \
    APP_PORT=8000

# Switch to non-root user
USER rally

EXPOSE 8000

# Container healthcheck using the lightweight /liveness endpoint
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8000/liveness || exit 1

# Production server entrypoint: Uvicorn without hot-reloading
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2", "--no-access-log"]
